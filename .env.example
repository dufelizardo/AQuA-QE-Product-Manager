# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env   (ou: Copy-Item .env.example .env no PowerShell)

# Ollama (local) — obrigatório enquanto LLM_PROVIDER=ollama (padrão)
# Instale o Ollama (https://ollama.com) e baixe os modelos usados por este agente:
#   ollama pull mistral   # geração (OLLAMA_MODEL)
#   ollama pull phi4      # revisão independente (OLLAMA_REVIEW_MODEL)
#   ollama pull bge-m3    # embeddings (OLLAMA_EMBEDDING_MODEL) — memória institucional de refinamento
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_REVIEW_MODEL=phi4
OLLAMA_EMBEDDING_MODEL=bge-m3

# Provedor de LLM ativo: "ollama" (padrão, modelos locais) ou "nvidia" (NVIDIA NIM,
# build.nvidia.com, API compatível com OpenAI). Piloto opcional — não altera o
# comportamento padrão se deixado comentado/ausente.
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
# NVIDIA_REVIEW_MODEL=meta/llama-3.3-70b-instruct

# Jira Cloud / Confluence Cloud — obrigatório apenas para usar --jira / --confluence
# (entrada) e --publicar-confluence (saída do PRD). Token gerado em
# id.atlassian.com/manage-profile/security/api-tokens. Confluence usa as
# mesmas credenciais do Jira.
JIRA_BASE_URL=https://seu-site.atlassian.net/
JIRA_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_SPACE_KEY=   # obrigatório apenas para usar --publicar-confluence
